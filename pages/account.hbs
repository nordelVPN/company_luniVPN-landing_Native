<section class="landing-section account-page wave-host" data-account-app data-wave-root data-wave-phase="1.6">
  <canvas class="wave-canvas section-wave-canvas" aria-hidden="true" data-wave-canvas></canvas>
  <div class="container">
  <div class="account-page-head">
    <div>
      <h1>{{intro.title}}</h1>
      <p class="section-lead">{{intro.description}}</p>
    </div>
    <div class="account-session-bar" hidden data-account-session-bar>
      <span class="session-badge" data-session-user>{{profile.displayName}}</span>
      <button class="button button-outline button-small" type="button" data-demo-signout>Sign out</button>
    </div>
  </div>

  <section class="panel demo-auth-card" aria-labelledby="demo-auth-title" data-account-auth>
    <h2 id="demo-auth-title">{{demoAuth.title}}</h2>
    <p class="muted">{{demoAuth.description}}</p>
    <form class="demo-auth-form" data-demo-signin-form>
      <div class="field-group">
        <label for="demo-auth-email">{{demoAuth.emailLabel}}</label>
        <input id="demo-auth-email" class="text-input" type="email" value="{{profile.email}}" readonly>
      </div>
      <div class="actions">
        <button class="button" type="submit" data-demo-signin>{{demoAuth.submitLabel}} <span aria-hidden="true">↗</span></button>
        <a class="button button-outline" href="{{basePath}}index.html">Back to home</a>
      </div>
    </form>
  </section>

  <div class="account-grid" data-account-portal>
    <nav class="account-nav" aria-label="Account sections" role="tablist">
      {{#each tabs}}
        <button
          id="tab-{{id}}"
          class="account-tab"
          type="button"
          role="tab"
          aria-selected="{{#if (eq id 'account')}}true{{else}}false{{/if}}"
          aria-controls="panel-{{id}}"
          data-account-tab="{{id}}"
        >
          <span class="account-tab-icon" aria-hidden="true">{{> shared/icon name=icon}}</span>
          <span>{{label}}</span>
        </button>
      {{/each}}
    </nav>

    <div class="account-content">
      <section
        id="panel-account"
        class="account-tab-panel"
        role="tabpanel"
        aria-labelledby="tab-account"
        data-account-panel="account"
      >
        <div class="panel profile-card">
          <div class="avatar" aria-hidden="true">{{> shared/icon name='user'}}</div>
          <div>
            <p class="eyebrow">PROFILE</p>
            <h2 data-profile-name>{{profile.displayName}}</h2>
            <p data-profile-email>{{profile.email}}</p>
          </div>
        </div>

        <form class="panel account-form" data-profile-form>
          <h3>Profile settings</h3>
          <div class="field-grid">
            <div class="field-group">
              <label for="profile-name-input">Display name</label>
              <input id="profile-name-input" class="text-input" type="text" name="displayName" value="{{profile.displayName}}" required>
            </div>
            <div class="field-group">
              <label for="profile-email-input">Email</label>
              <input id="profile-email-input" class="text-input" type="email" name="email" value="{{profile.email}}" required>
            </div>
          </div>
          <div class="actions">
            <button class="button button-small" type="submit">Save profile</button>
          </div>
          <p class="muted" role="status" aria-live="polite" data-profile-status></p>
        </form>
      </section>

      <section
        id="panel-subscription"
        class="account-tab-panel"
        role="tabpanel"
        aria-labelledby="tab-subscription"
        data-account-panel="subscription"
      >
        <div class="panel">
          <p class="eyebrow">SUBSCRIPTION</p>
          <h2>Manage subscription</h2>
          <dl>
            <div><dt>Current plan</dt><dd data-sub-plan>Basic</dd></div>
            <div><dt>Billing period</dt><dd data-sub-period>1 month</dd></div>
            <div><dt>Status</dt><dd data-sub-status>{{subscription.status}}</dd></div>
            <div><dt>Renewal</dt><dd data-sub-renewal>{{subscription.renewalDate}}</dd></div>
            <div><dt>Payment method</dt><dd>{{subscription.paymentMethod}}</dd></div>
          </dl>
          <div class="actions subscription-actions">
            <button class="button button-small" type="button" data-goto-tab="plans">Change plan</button>
            <button class="button button-outline button-small" type="button" data-sub-toggle-pause>Pause</button>
            <button class="button button-outline button-small" type="button" data-sub-cancel>Cancel</button>
            <button class="button button-outline button-small" type="button" data-goto-tab="checkout">Open checkout</button>
          </div>
          <p class="muted" role="status" aria-live="polite" data-sub-message></p>
        </div>
      </section>

      <section
        id="panel-plans"
        class="account-tab-panel"
        role="tabpanel"
        aria-labelledby="tab-plans"
        data-account-panel="plans"
      >
        <div class="panel-intro">
          <h2>Choose a plan</h2>
          <p class="muted">Select Trial, Basic, Plus, or Complete to continue to checkout.</p>
        </div>
        <div class="plans-grid account-plans-grid" data-plans-root>
          {{#each plans}}
            <article class="plan-card {{#if featured}}plan-featured{{/if}}" data-plan-card="{{planId}}">
              <picture class="plan-art" aria-hidden="true">
                <source srcset="{{@root.assets.cardWaveWebp}}" type="image/webp">
                <img src="{{@root.assets.cardWavePng}}" alt="" width="530" height="325" loading="lazy" decoding="async">
              </picture>
              {{#if featured}}
                <span class="plan-badge">{{> shared/icon name='leaf'}} Best value</span>
              {{/if}}
              <h3>{{displayName}}</h3>
              <p class="plan-subtitle">{{subtitle}}</p>
              <p class="plan-price-row">
                <span class="plan-price">{{priceDisplay}}</span>
                <span class="plan-duration">/ {{durationLabel}}</span>
              </p>
              <ul>
                {{#each featureItems}}
                  <li>
                    <span class="plan-feature-icon" aria-hidden="true">{{> shared/icon name=icon}}</span>
                    <span>{{text}}</span>
                  </li>
                {{/each}}
              </ul>
              <button class="button" type="button" data-account-select-plan="{{planId}}">
                Choose {{displayName}} <span aria-hidden="true">↗</span>
              </button>
            </article>
          {{/each}}
        </div>
      </section>

      <section
        id="panel-checkout"
        class="account-tab-panel"
        role="tabpanel"
        aria-labelledby="tab-checkout"
        data-account-panel="checkout"
        data-checkout
      >
        <div class="checkout-grid">
          <div class="panel checkout-form">
            <h2>Selected plan</h2>
            <div class="checkout-plan-card">
              <span class="checkout-plan-mark" aria-hidden="true"></span>
              <div class="checkout-plan-info">
                <p class="checkout-plan-name" data-selected-plan>Choose a plan first</p>
                <p class="checkout-plan-sub" data-plan-prompt>Pick Trial, Basic, Plus, or Complete in Plans to review your order summary.</p>
              </div>
            </div>
            <button class="change-plan-link" type="button" data-goto-tab="plans">Change plan</button>

            <div class="checkout-preview" aria-label="Payment details">
              <div class="demo-field-group">
                <span class="demo-field-label">Email</span>
                <div class="demo-field" aria-hidden="true"><span>{{profile.email}}</span></div>
              </div>
              <div class="demo-field-group">
                <span class="demo-field-label">Card details</span>
                <div class="demo-fields" aria-hidden="true">
                  <div class="demo-field demo-field-card">
                    <span class="demo-card-icon">{{> shared/icon name='card'}}</span>
                    <span>•••• •••• •••• 0000</span>
                  </div>
                  <div class="demo-field-row">
                    <div class="demo-field"><span>MM / YY</span><span>— / —</span></div>
                    <div class="demo-field"><span>CVC</span><span>•••</span></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <aside class="summary-card" aria-labelledby="account-order-summary-title">
            <h3 id="account-order-summary-title">Order summary</h3>
            <div class="checkout-plan-card checkout-plan-card-compact">
              <span class="checkout-plan-mark" aria-hidden="true"></span>
              <div class="checkout-plan-info">
                <p class="checkout-plan-name" data-selected-plan>Choose a plan first</p>
                <p class="checkout-plan-sub">LuniVPN subscription</p>
              </div>
            </div>
            <dl>
              <div><dt>Plan</dt><dd data-plan-period>—</dd></div>
              <div class="total"><dt>Total</dt><dd data-plan-total>—</dd></div>
            </dl>
            <button class="button" type="button" data-checkout-button disabled>
              Continue to payment <span aria-hidden="true">↗</span>
            </button>
            <button class="button button-outline summary-secondary-btn" type="button" data-apply-demo-plan disabled>
              Switch active plan
            </button>
            <p class="muted checkout-status-note" role="status" aria-live="polite" data-checkout-message></p>
          </aside>
        </div>
      </section>

      <section
        id="panel-help"
        class="account-tab-panel"
        role="tabpanel"
        aria-labelledby="tab-help"
        data-account-panel="help"
      >
        <div class="panel">
          <p class="eyebrow">HELP</p>
          <h2>How can we help?</h2>
          <p class="muted">Find answers about your LuniVPN account, plans, and connection.</p>
          <div class="support-search-wrap">
            <label class="sr-only" for="account-help-search">{{help.searchLabel}}</label>
            <div class="search-field">
              <span class="search-icon" aria-hidden="true">{{> shared/icon name='search'}}</span>
              <input
                id="account-help-search"
                class="search-input"
                type="search"
                placeholder="{{help.searchPlaceholder}}"
              >
            </div>
          </div>
          <div class="help-cards">
            {{#each help.categories}}
              <article class="help-card">
                <span class="feature-icon" aria-hidden="true">{{> shared/feature-icon name=icon}}</span>
                <h3>{{title}}</h3>
                <p>{{description}}</p>
                <span class="unavailable">{{unavailableReason}}</span>
              </article>
            {{/each}}
          </div>
          <div class="actions help-wishlist-cta">
            <button class="button button-outline button-small" type="button" data-wishlist-open>
              {{site.wishlist.label}}
            </button>
          </div>
        </div>
      </section>
    </div>
  </div>
  </div>
</section>
