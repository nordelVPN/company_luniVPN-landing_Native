<section class="landing-section legal-page" aria-labelledby="forgot-title">
  <div class="container legal-container">
    <p class="eyebrow" data-i18n="auth.eyebrow">LuniVPN Account</p>
    <h1 id="forgot-title" data-i18n="auth.forgotTitle">Reset password</h1>
    <p class="section-lead" data-i18n="auth.forgotLead">Enter your account email and we will send password reset instructions.</p>
    <form class="panel account-form" data-portal-forgot novalidate>
      <div class="portal-status" role="status" aria-live="polite" data-portal-status hidden></div>
      <div class="field-group">
        <label for="luni-forgot-email" data-i18n="auth.emailLabel">Email</label>
        <input id="luni-forgot-email" class="text-input" type="email" name="email" required autocomplete="email" placeholder="you@example.com" data-i18n-placeholder="auth.emailPlaceholder">
      </div>
      <div class="actions">
        <button class="button" type="submit"><span data-i18n="auth.forgotSubmit">Send reset link</span> <span aria-hidden="true">↗</span></button>
        <a class="button button-outline" href="./login.html" data-i18n="auth.backToLogin">Back to sign in</a>
      </div>
      <p class="portal-consent-note">
        <span data-i18n="auth.consentPrefix">By continuing, you agree to our</span>
        <a href="./terms.html" data-i18n="footer.terms">Terms of Service</a>
        <span data-i18n="auth.consentAnd">and</span>
        <a href="./privacy.html" data-i18n="footer.privacy">Privacy Policy</a>.
      </p>
    </form>
    <form class="panel account-form" data-portal-reset hidden novalidate>
      <div class="portal-status" role="status" aria-live="polite" data-portal-status hidden></div>
      <input type="hidden" name="token">
      <div class="field-group">
        <label for="luni-reset-pass" data-i18n="auth.newPasswordLabel">New password (min 8 characters)</label>
        <input id="luni-reset-pass" class="text-input" type="password" name="password" required minlength="8" autocomplete="new-password">
      </div>
      <div class="field-group">
        <label for="luni-reset-confirm" data-i18n="auth.confirmPasswordLabel">Confirm new password</label>
        <input id="luni-reset-confirm" class="text-input" type="password" name="password_confirmation" required minlength="8" autocomplete="new-password">
      </div>
      <div class="actions">
        <button class="button" type="submit"><span data-i18n="auth.resetSubmit">Set new password</span> <span aria-hidden="true">↗</span></button>
      </div>
    </form>
  </div>
</section>
