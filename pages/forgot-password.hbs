<section class="landing-section legal-page" aria-labelledby="forgot-title">
  <div class="container legal-container">
    <p class="eyebrow">LuniVPN Account</p>
    <h1 id="forgot-title">Reset password</h1>
    <p class="section-lead">Enter your account email and we will send password reset instructions.</p>
    <form class="panel account-form" data-portal-forgot>
      <p class="muted" role="status" aria-live="polite" data-portal-status hidden></p>
      <div class="field-group">
        <label for="luni-forgot-email">Email</label>
        <input id="luni-forgot-email" class="text-input" type="email" name="email" required autocomplete="email" placeholder="you@example.com">
      </div>
      <div class="actions">
        <button class="button" type="submit">Send reset link <span aria-hidden="true">↗</span></button>
        <a class="button button-outline" href="./login.html">Back to sign in</a>
      </div>
    </form>
    <form class="panel account-form" data-portal-reset hidden>
      <p class="muted" role="status" aria-live="polite" data-portal-status hidden></p>
      <input type="hidden" name="token">
      <div class="field-group">
        <label for="luni-reset-pass">New password (min 8 characters)</label>
        <input id="luni-reset-pass" class="text-input" type="password" name="password" required minlength="8" autocomplete="new-password">
      </div>
      <div class="field-group">
        <label for="luni-reset-confirm">Confirm new password</label>
        <input id="luni-reset-confirm" class="text-input" type="password" name="password_confirmation" required minlength="8" autocomplete="new-password">
      </div>
      <div class="actions">
        <button class="button" type="submit">Set new password <span aria-hidden="true">↗</span></button>
      </div>
    </form>
  </div>
</section>
