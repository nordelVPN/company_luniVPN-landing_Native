<section class="landing-section legal-page" aria-labelledby="legal-title">
  <div class="container legal-container">
    <p class="eyebrow" data-i18n="terms.eyebrow">{{legal.eyebrow}}</p>
    <h1 id="legal-title" data-i18n="terms.heading">{{legal.title}}</h1>
    <p class="section-lead" data-i18n="terms.lead">{{legal.lead}}</p>
    <p class="demo-notice" role="note" data-i18n="terms.notice">{{legal.notice}}</p>
    <div class="legal-sections">
      {{#each legal.sections}}
        <article class="panel legal-card">
          <h2 data-i18n="terms.sections.{{@index}}.heading">{{heading}}</h2>
          <p data-i18n="terms.sections.{{@index}}.body">{{body}}</p>
        </article>
      {{/each}}
    </div>
    <p class="legal-back">
      <a class="change-plan-link" href="{{basePath}}index.html" data-i18n="legal.backHome">← Back to LuniVPN home</a>
    </p>
  </div>
</section>
