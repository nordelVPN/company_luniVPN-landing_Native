<section class="landing-section legal-page" aria-labelledby="legal-title">
  <div class="container legal-container">
    <p class="eyebrow">{{legal.eyebrow}}</p>
    <h1 id="legal-title">{{legal.title}}</h1>
    <p class="section-lead">{{legal.lead}}</p>
    <p class="demo-notice" role="note">{{legal.notice}}</p>
    <div class="legal-sections">
      {{#each legal.sections}}
        <article class="panel legal-card">
          <h2>{{heading}}</h2>
          <p>{{body}}</p>
        </article>
      {{/each}}
    </div>
    <p class="legal-back">
      <a class="change-plan-link" href="{{basePath}}index.html">← Back to LuniVPN home</a>
    </p>
  </div>
</section>
