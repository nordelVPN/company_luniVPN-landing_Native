{
  "name": "lunivpn-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "webpack serve --config webpack/webpack.dev.js",
    "build:dev": "webpack --config webpack/webpack.dev.js",
    "build:prod": "webpack --config webpack/webpack.prod.js",
    "build": "npm run build:prod",
    "lint": "eslint .",
    "start:live": "node -e \"const {spawnSync}=require('child_process');process.exit(spawnSync('npm',['start'],{stdio:'inherit',shell:true,env:{...process.env,DATA_MODE:'live',BRAND_SLUG:'luni',PORT:process.env.PORT||'3002',SITE_PORT:process.env.SITE_PORT||'3002',PORTAL_API_URL:process.env.PORTAL_API_URL||'http://localhost:8081',SERVERS_API_URL:process.env.SERVERS_API_URL||'http://localhost:8082',SERVERS_CATALOG_URL:process.env.SERVERS_CATALOG_URL||'/_api/servers'}}).status||0)\"",
    "start:demo": "node -e \"const {spawnSync}=require('child_process');process.exit(spawnSync('npm',['start'],{stdio:'inherit',shell:true,env:{...process.env,DATA_MODE:'demo',BRAND_SLUG:'luni',PORT:process.env.PORT||'3002',SITE_PORT:process.env.SITE_PORT||'3002'}}).status||0)\""
  },
  "engines": {
    "node": "24.21.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.25.1",
    "handlebars": "^4.7.8",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "sass": "^1.86.3",
    "sass-loader": "^16.0.5",
    "webpack": "^5.99.5",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "webpack-merge": "^6.0.1"
  }
}
