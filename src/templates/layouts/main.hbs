<!doctype html>
<html lang="{{metadata.lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" data-i18n-content="{{metadata.pageId}}.description" content="{{metadata.description}}">
  <meta name="robots" content="{{robots}}">
  <title data-i18n="{{metadata.pageId}}.title">{{metadata.title}}</title>
  {{#if canonical}}<link rel="canonical" href="{{canonical}}">{{/if}}
  {{#if (eq metadata.pageId 'account')}}<style>[data-auth-gate][hidden]{display:none!important;}[data-auth-gate]:not([hidden]){animation:auth-gate-reveal .16s ease-out;}[data-auth-gate]:not([hidden])+[data-auth-gate-loader],[data-auth-gate-loader][hidden]{display:none!important;}.auth-gate-loader{min-height:72vh;padding:clamp(2.25rem,4vw,3.5rem) clamp(1rem,4vw,2.5rem);display:grid;align-content:start;gap:1.5rem;max-width:1280px;width:100%;margin:0 auto;box-sizing:border-box;}.auth-gate-loader__top{display:flex;align-items:center;gap:.75rem;}.auth-gate-loader__spinner{width:20px;height:20px;border-radius:50%;border:2.5px solid color-mix(in srgb,currentColor 20%,transparent);border-top-color:currentColor;animation:auth-gate-spin .75s linear infinite;flex-shrink:0;}.auth-gate-loader__grid{display:grid;grid-template-columns:220px minmax(0,1fr);gap:2rem;align-items:start;}.auth-gate-loader__sidebar,.auth-gate-loader__card{border-radius:16px;border:1px solid color-mix(in srgb,currentColor 14%,transparent);background:color-mix(in srgb,currentColor 4%,transparent);padding:1.25rem;display:grid;gap:.85rem;}.auth-gate-loader__main{display:grid;gap:1.25rem;}.auth-gate-loader__bar{height:14px;border-radius:8px;background:color-mix(in srgb,currentColor 12%,transparent);animation:auth-gate-pulse 1.3s ease-in-out infinite;}.auth-gate-loader__bar--title{height:24px;width:42%;}.auth-gate-loader__bar--wide{width:85%;}.auth-gate-loader__bar--mid{width:62%;}.auth-gate-loader__bar--btn{height:38px;width:160px;border-radius:999px;margin-top:.25rem;}@keyframes auth-gate-spin{to{transform:rotate(360deg);}}@keyframes auth-gate-pulse{0%,100%{opacity:.45;}50%{opacity:.9;}}@keyframes auth-gate-reveal{from{opacity:0;}to{opacity:1;}}@media(max-width:900px){.auth-gate-loader__grid{grid-template-columns:1fr;}}@media(prefers-reduced-motion:reduce){[data-auth-gate]:not([hidden]),.auth-gate-loader__spinner,.auth-gate-loader__bar{animation:none;}}</style><script>(function(){try{if(window.__VPN_PORTAL_CONFIG__&&window.__VPN_PORTAL_CONFIG__.mode==='demo')return;if(!window.localStorage.getItem('luni-vpn-portal:token')){window.location.replace('./login.html');}}catch(e){window.location.replace('./login.html');}})();</script>{{/if}}
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4N33FKBNLK"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4N33FKBNLK');
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="page-{{metadata.pageId}}">
  <a class="skip-link" href="#main-content" data-i18n="skip">Skip to content</a>
  <div class="page-shell" data-page-shell>
    {{> shared/header}}
    <main id="main-content"{{#if (eq metadata.pageId 'account')}} hidden data-auth-gate{{/if}}>{{{body}}}</main>
    {{#if (eq metadata.pageId 'account')}}
    <div class="auth-gate-loader" data-auth-gate-loader role="status" aria-busy="true" aria-label="Loading account">
      <div class="auth-gate-loader__top"><span class="auth-gate-loader__spinner" aria-hidden="true"></span><span class="auth-gate-loader__bar auth-gate-loader__bar--title"></span></div>
      <div class="auth-gate-loader__grid">
        <div class="auth-gate-loader__sidebar"><span class="auth-gate-loader__bar auth-gate-loader__bar--wide"></span><span class="auth-gate-loader__bar auth-gate-loader__bar--mid"></span><span class="auth-gate-loader__bar auth-gate-loader__bar--wide"></span><span class="auth-gate-loader__bar auth-gate-loader__bar--mid"></span></div>
        <div class="auth-gate-loader__main">
          <div class="auth-gate-loader__card"><span class="auth-gate-loader__bar auth-gate-loader__bar--title"></span><span class="auth-gate-loader__bar auth-gate-loader__bar--wide"></span><span class="auth-gate-loader__bar auth-gate-loader__bar--btn"></span></div>
          <div class="auth-gate-loader__card"><span class="auth-gate-loader__bar auth-gate-loader__bar--mid"></span><span class="auth-gate-loader__bar auth-gate-loader__bar--wide"></span><span class="auth-gate-loader__bar auth-gate-loader__bar--mid"></span></div>
        </div>
      </div>
    </div>
    {{/if}}
    {{> shared/footer}}
  </div>
  {{> shared/wishlist-dialog}}
  {{#if (eq metadata.pageId 'index')}}
    {{> sections/checkout}}
  {{/if}}
</body>
</html>
