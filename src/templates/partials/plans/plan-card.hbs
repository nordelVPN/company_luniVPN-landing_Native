<article class="plan-card {{#if (eq planId 'yearly')}}plan-featured{{/if}}" data-plan-card="{{planId}}">
  <picture class="plan-art" aria-hidden="true">
    <source srcset="{{@root.assets.cardWaveWebp}}" type="image/webp">
    <img src="{{@root.assets.cardWavePng}}" alt="" width="530" height="314" loading="lazy" decoding="async">
  </picture>
  {{#if (eq planId 'yearly')}}<span class="plan-badge">Best value</span>{{/if}}
  <h3>{{displayName}}</h3>
  <p>More room for what matters.</p>
  <ul>
    {{#each features}}<li>{{this}}</li>{{/each}}
  </ul>
  <a
    class="button"
    href="?plan={{planId}}#checkout"
    data-select-plan="{{planId}}"
  >
    Choose {{displayName}} <span aria-hidden="true">↗</span>
  </a>
</article>
