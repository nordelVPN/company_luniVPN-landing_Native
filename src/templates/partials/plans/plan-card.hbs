<article class="plan-card {{#if featured}}plan-featured{{/if}}" data-plan-card="{{planId}}">
  <picture class="plan-art" aria-hidden="true">
    <source srcset="{{@root.assets.cardWaveWebp}}" type="image/webp">
    <img src="{{@root.assets.cardWavePng}}" alt="" width="530" height="325" loading="lazy" decoding="async">
  </picture>
  {{#if featured}}
    <span class="plan-badge">{{> shared/icon name='leaf'}} Best value</span>
  {{/if}}
  <h3>{{displayName}}</h3>
  <p class="plan-subtitle">{{subtitle}}</p>
  <p class="plan-price-row">
    <span class="plan-price">{{priceDisplay}}</span>
    <span class="plan-duration">/ {{durationLabel}}</span>
  </p>
  <ul>
    {{#each featureItems}}
      <li>
        <span class="plan-feature-icon" aria-hidden="true">{{> shared/icon name=icon}}</span>
        <span>{{text}}</span>
      </li>
    {{/each}}
  </ul>
  <a
    class="button"
    href="?plan={{planId}}#checkout"
    data-select-plan="{{planId}}"
  >
    Choose {{displayName}} <span aria-hidden="true">↗</span>
  </a>
</article>
