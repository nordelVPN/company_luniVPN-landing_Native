<header class="site-header" data-nav-root>
  <div class="container header-inner">
    {{> shared/logo}}
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
      data-i18n-aria-label="nav.open"
      data-nav-toggle
    >
      <span aria-hidden="true">☰</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main navigation" data-i18n-aria-label="nav.main" data-nav-panel>
      <div class="site-nav-links">
        {{#each site.navigation}}
          <a
            href="{{#if (eq ../metadata.pageId 'index')}}{{hash}}{{else}}./index.html{{hash}}{{/if}}"
            data-nav-link="{{id}}"
            data-i18n="nav.{{id}}"
          >{{label}}</a>
        {{/each}}
        <a
          href="./login.html"
          data-account-link
          {{#if (eq metadata.pageId 'account')}}aria-current="page"{{/if}}
          data-i18n="nav.account"
        >{{site.accountLink.label}}</a>
        <a
          href="./login.html"
          {{#if (eq metadata.pageId 'login')}}aria-current="page"{{/if}}
          data-i18n="nav.login"
        >Log in</a>
        <a
          href="./create-account.html"
          {{#if (eq metadata.pageId 'create-account')}}aria-current="page"{{/if}}
          data-i18n="nav.createAccount"
        >Create account</a>
        <a
          href="./forgot-password.html"
          {{#if (eq metadata.pageId 'forgot-password')}}aria-current="page"{{/if}}
          data-i18n="nav.forgotPassword"
        >Forgot password</a>
      </div>
      <div class="site-nav-actions">
        <label class="language">
          <span class="sr-only" data-i18n="language.label">Language</span>
          <select
            class="language-select"
            data-language-select
            aria-label="Language"
            data-i18n-aria-label="language.label"
          >
            <option value="en">EN</option>
            <option value="ru">RU</option>
          </select>
        </label>
        <button class="button button-outline button-small" type="button" data-wishlist-open data-i18n="nav.wishlist">
          {{site.wishlist.label}}
        </button>
        <a
          class="button button-small"
          href="{{#if (eq metadata.pageId 'index')}}{{site.cta.hash}}{{else}}./index.html{{site.cta.hash}}{{/if}}"
          data-nav-link="plans"
        >
          <span data-i18n="nav.cta">{{site.cta.label}}</span> <span aria-hidden="true">↗</span>
        </a>
      </div>
    </nav>
  </div>
</header>
