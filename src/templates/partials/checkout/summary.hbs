<aside class="summary-card" aria-labelledby="order-summary-title">
  <h3 id="order-summary-title" data-i18n="checkout.orderSummary">Order summary</h3>
  <div class="checkout-plan-card checkout-plan-card-compact">
    <span class="checkout-plan-mark" aria-hidden="true"></span>
    <div class="checkout-plan-info">
      <p class="checkout-plan-name" data-selected-plan data-i18n="checkout.chooseFirst">Choose a plan first</p>
      <p class="checkout-plan-sub" data-i18n="checkout.subscriptionSub">LuniVPN subscription</p>
    </div>
  </div>
  <dl>
    <div><dt data-i18n="checkout.planLabel">Plan</dt><dd data-plan-period>—</dd></div>
    <div class="total"><dt data-i18n="checkout.totalLabel">Total</dt><dd data-plan-total>—</dd></div>
  </dl>
  <button class="button" type="button" data-checkout-button disabled>
    <span data-i18n="checkout.continue">Continue to payment</span> <span aria-hidden="true">↗</span>
  </button>
  <p class="muted checkout-status-note" role="status" aria-live="polite" data-checkout-message></p>
</aside>
