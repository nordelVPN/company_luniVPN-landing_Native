<aside class="summary-card" aria-labelledby="order-summary-title">
  <h3 id="order-summary-title">Order summary</h3>
  <p class="summary-plan" data-selected-plan>Choose a plan first</p>
  <dl>
    <div><dt>Plan</dt><dd data-plan-period>—</dd></div>
    <div class="total"><dt>Total</dt><dd data-plan-total>—</dd></div>
  </dl>
  <button class="button" type="button" data-checkout-button disabled>
    Continue to payment <span aria-hidden="true">↗</span>
  </button>
  <p class="muted" role="status" aria-live="polite" data-checkout-message>
    Payment is unavailable in this demo.
  </p>
</aside>
