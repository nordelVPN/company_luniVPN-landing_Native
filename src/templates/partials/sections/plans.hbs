<section id="plans" class="landing-section section-plans" aria-labelledby="plans-title">
  <div class="section-intro container">
    <h2 id="plans-title" class="section-display-title" data-i18n="plans.sectionTitle">{{plansSection.title}}</h2>
    <p class="section-lead" data-i18n="plans.sectionDescription">{{plansSection.description}}</p>
  </div>
  <div class="plans-grid container" aria-label="Plans" data-plans-root>
    {{#each plans}}
      {{> plans/plan-card}}
    {{/each}}
  </div>
</section>
