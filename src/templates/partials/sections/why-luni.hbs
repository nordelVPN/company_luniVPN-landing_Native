<section id="why-luni" class="landing-section section-why-luni wave-host" aria-labelledby="why-luni-title" data-wave-root data-wave-phase="4.8">
  <canvas class="wave-canvas section-wave-canvas" aria-hidden="true" data-wave-canvas></canvas>
  <div class="section-intro container">
    <p class="eyebrow" data-i18n="whyLuni.eyebrow">{{whyLuni.eyebrow}}</p>
    <h2 id="why-luni-title" class="section-display-title" data-i18n="whyLuni.title">{{whyLuni.title}}</h2>
    <p class="section-lead" data-i18n="whyLuni.description">{{whyLuni.description}}</p>
    <div class="actions">
      <a class="button" href="{{whyLuni.primaryCta.href}}"><span data-i18n="whyLuni.primaryCta">{{whyLuni.primaryCta.label}}</span> <span aria-hidden="true">↗</span></a>
      <a class="button button-outline" href="{{whyLuni.secondaryCta.href}}" data-i18n="whyLuni.secondaryCta">{{whyLuni.secondaryCta.label}}</a>
    </div>
  </div>
  <div class="luni-way container">
    <div class="luni-way-visual" aria-hidden="true">
      <picture>
        <source srcset="{{assets.luniWayLeafWebp}}" type="image/webp">
        <img src="{{assets.luniWayLeafPng}}" alt="" width="585" height="272" loading="lazy" decoding="async">
      </picture>
    </div>
    <div class="luni-way-copy">
      <p class="eyebrow" data-i18n="whyLuni.luniWay.eyebrow">{{whyLuni.luniWay.eyebrow}}</p>
      <h3 data-i18n="whyLuni.luniWay.title">{{whyLuni.luniWay.title}}</h3>
      {{#each whyLuni.luniWay.paragraphs}}
        <p data-i18n="whyLuni.luniWay.paragraphs.{{@index}}">{{this}}</p>
      {{/each}}
    </div>
  </div>
</section>
