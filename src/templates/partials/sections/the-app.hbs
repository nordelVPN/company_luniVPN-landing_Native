<section id="the-app" class="landing-section section-the-app wave-host" aria-labelledby="the-app-title" data-wave-root data-wave-phase="2.4">
  <canvas class="wave-canvas section-wave-canvas" aria-hidden="true" data-wave-canvas></canvas>
  <div class="hero container app-hero">
    <div class="hero-copy">
      <h2 id="the-app-title" class="section-display-title" data-i18n="theApp.title">{{theApp.title}}</h2>
      <p class="hero-kicker" data-i18n="theApp.kicker">{{theApp.kicker}}</p>
      <p class="hero-description" data-i18n="theApp.description">{{theApp.description}}</p>
      <div class="actions">
        <a class="button" href="{{theApp.primaryCta.href}}"><span data-i18n="theApp.primaryCta">{{theApp.primaryCta.label}}</span> <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href="{{theApp.secondaryCta.href}}" data-i18n="theApp.secondaryCta">{{theApp.secondaryCta.label}}</a>
      </div>
    </div>
    <div class="device-art">
      <picture>
        <source srcset="{{assets.theAppDevicesWebp}}" type="image/webp">
        <img
          src="{{assets.theAppDevicesPng}}"
          alt="LuniVPN app preview across laptop, smartphone and tablet"
          width="891"
          height="520"
          loading="lazy"
          decoding="async"
        >
      </picture>
    </div>
  </div>
  <div id="the-app-highlights" class="features container" aria-label="App highlights">
    {{#each theApp.highlights}}
      <article class="feature">
        <span class="feature-icon" aria-hidden="true">{{> shared/feature-icon name=icon}}</span>
        <h3 data-i18n="theApp.highlights.{{@index}}.title">{{title}}</h3>
        <p data-i18n="theApp.highlights.{{@index}}.description">{{description}}</p>
      </article>
    {{/each}}
  </div>
</section>
