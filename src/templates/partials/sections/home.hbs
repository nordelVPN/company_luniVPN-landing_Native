<section id="home" class="landing-section section-home" aria-labelledby="home-title">
  <div class="home-hero-stage wave-host" data-wave-root data-wave-phase="0">
    <canvas class="wave-canvas home-wave-canvas" aria-hidden="true" data-wave-canvas></canvas>
    <div class="hero hero-single container">
      <div class="hero-copy">
        <h1 id="home-title">{{home.title}}</h1>
        <p class="hero-kicker">{{home.kicker}}</p>
        <p class="hero-description">{{home.description}}</p>
        <div class="actions">
          <a class="button" href="{{home.primaryCta.href}}">{{home.primaryCta.label}} <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href="{{home.secondaryCta.href}}">{{home.secondaryCta.label}}</a>
        </div>
      </div>
    </div>
  </div>
  <div class="home-features-band">
    <div class="container">
      <div class="features-header">
        <h2 class="features-heading">{{home.featuresTitle}}</h2>
        <p class="features-subheading">{{home.featuresLead}}</p>
      </div>
      <div class="features" aria-label="Home highlights">
        {{#each home.features}}
          <article class="feature">
            <span class="feature-icon" aria-hidden="true">{{> shared/feature-icon name=icon}}</span>
            <h3>{{title}}</h3>
            <p>{{description}}</p>
          </article>
        {{/each}}
      </div>
    </div>
  </div>
</section>
