<div
  id="checkout"
  class="checkout-backdrop"
  hidden
  data-checkout
  data-checkout-dialog
>
  <div
    class="checkout-dialog wave-host"
    role="dialog"
    aria-modal="true"
    aria-labelledby="checkout-title"
    tabindex="-1"
    data-checkout-panel
    data-wave-root
    data-wave-phase="9.6"
  >
    <canvas class="wave-canvas checkout-wave-canvas" aria-hidden="true" data-wave-canvas></canvas>
    <div class="checkout-dialog-inner">
    <div class="checkout-dialog-head">
      <div>
        <h2 id="checkout-title" data-i18n="checkout.title">{{checkout.title}}</h2>
        <p class="checkout-subtitle" data-i18n="checkout.description">{{checkout.description}}</p>
      </div>
      <button
        class="wishlist-close"
        type="button"
        aria-label="Close checkout"
        data-i18n-aria-label="checkout.closeLabel"
        data-checkout-close
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="checkout-grid">
      <div class="checkout-form">
        <h3 data-i18n="checkout.selectedPlanHeading">Selected plan</h3>
        <div class="checkout-plan-card">
          <picture class="checkout-plan-art" aria-hidden="true">
            <source srcset="{{assets.cardWaveWebp}}" type="image/webp">
            <img src="{{assets.cardWavePng}}" alt="" width="530" height="325" loading="lazy" decoding="async">
          </picture>
          <span class="checkout-plan-mark" aria-hidden="true"></span>
          <div class="checkout-plan-info">
            <p class="checkout-plan-name" data-selected-plan data-i18n="checkout.chooseFirst">Choose a plan first</p>
            <p class="checkout-plan-sub" data-selected-plan-subtitle data-i18n="checkout.chooseHint">Select Trial, Basic, Plus, or Complete in Plans.</p>
          </div>
        </div>

        <fieldset class="checkout-plan-switcher" aria-label="Choose plan">
          <legend class="checkout-field-label" data-i18n="checkout.changePlan">Change plan</legend>
          <div class="checkout-plan-options">
            <label class="checkout-plan-option">
              <input type="radio" name="checkout-plan" value="trial">
              <span data-i18n="plans.trial.name">Trial</span>
              <strong>€0.50</strong>
            </label>
            <label class="checkout-plan-option">
              <input type="radio" name="checkout-plan" value="basic">
              <span data-i18n="plans.basic.name">Basic</span>
              <strong>€7</strong>
            </label>
            <label class="checkout-plan-option">
              <input type="radio" name="checkout-plan" value="plus" checked>
              <span data-i18n="plans.plus.name">Plus</span>
              <strong>€25</strong>
            </label>
            <label class="checkout-plan-option">
              <input type="radio" name="checkout-plan" value="complete">
              <span data-i18n="plans.complete.name">Complete</span>
              <strong>€55</strong>
            </label>
          </div>
        </fieldset>

        <div class="checkout-email-field">
          <label class="checkout-field-label" for="luni-checkout-email" data-i18n="checkout.emailLabel">Email</label>
          <input
            id="luni-checkout-email"
            class="text-input"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            data-i18n-placeholder="auth.emailPlaceholder"
          >
          <p class="portal-field-error" data-field-error="email"></p>
        </div>
      </div>
      {{> checkout/summary}}
    </div>
    </div>
  </div>
</div>
