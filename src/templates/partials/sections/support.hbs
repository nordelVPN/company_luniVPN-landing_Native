<section id="support" class="landing-section section-support wave-host" aria-labelledby="support-title" data-wave-root data-wave-phase="7.2">
  <canvas class="wave-canvas section-wave-canvas" aria-hidden="true" data-wave-canvas></canvas>
  <div class="section-intro container">
    <p class="eyebrow">{{support.eyebrow}}</p>
    <h2 id="support-title" class="section-display-title">{{support.title}}</h2>
    <p class="section-lead">{{support.description}}</p>
    <div class="support-search-wrap">
      <label class="sr-only" for="support-search-input">{{support.searchLabel}}</label>
      <div class="search-field">
        <span class="search-icon" aria-hidden="true">{{> shared/icon name='search'}}</span>
        <input
          id="support-search-input"
          class="search-input"
          type="search"
          placeholder="{{support.searchPlaceholder}}"
        >
      </div>
    </div>
  </div>
  <div class="features support-categories container" aria-label="Help categories">
    {{#each support.categories}}
      <article class="feature support-card">
        <span class="feature-icon" aria-hidden="true">{{> shared/feature-icon name=icon}}</span>
        <h3>{{title}}</h3>
        <p>{{description}}</p>
        <div class="support-card-action">
          <button class="button button-outline button-chip" type="button" disabled title="{{unavailableReason}}">
            {{actionLabel}} {{> shared/icon name='chevron-right'}}
          </button>
          <span class="unavailable">{{unavailableReason}}</span>
        </div>
      </article>
    {{/each}}
  </div>
</section>
